// Reference copy of settings.json with optional entries.
// Claude Code does NOT read this file. To enable an entry,
// copy it into settings.json without the // (and fix commas).
{
  "permissions": {
    "deny": [
      "NotebookEdit",
      "DesignSync",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterPlanMode",
      "ExitPlanMode"
      // "PushNotification",
      // "RemoteTrigger",
      // "ReportFindings",
      // "ScheduleWakeup"
    ]
  },
  "disableClaudeAiConnectors": true,
  "disableWorkflows": true,
  "disableBundledSkills": true,
  "disableArtifact": true
}
